---
import { CatalogPage } from '@/modules/catalog'
import { loadCatalogPage } from '@/modules/catalog/index.server'

const page = await loadCatalogPage(Astro.params.slugs, Astro.url.searchParams)
if (page.status === 'not-found') return Astro.rewrite('/404')
---

<CatalogPage query={page.query} result={page.result} />
