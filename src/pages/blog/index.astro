---
import { BlogListView, SECTION_PARAM } from '@/modules/blog'
import { loadArticleSections, loadLatestArticles } from '@/modules/blog/index.server'

const activeSection = Astro.url.searchParams.get(SECTION_PARAM) || undefined
const [blog, sections] = await Promise.all([
  loadLatestArticles(activeSection),
  loadArticleSections(),
])
---

<BlogListView {blog} {sections} {activeSection} />
