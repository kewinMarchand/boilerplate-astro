---
import { ImageCarousel } from '@/shared/ui/carousel'
import { Alert } from '@/shared/ui/kit'

import type { Slide } from '../domain/slide'

interface Props {
  carousel: Slide.Carousel
}

const { carousel } = Astro.props
// Sans diapositive, le carrousel n'a rien à montrer : la section disparaît de l'accueil.
const visible = carousel.status === 'error' || carousel.slides.length > 0
---

{visible && (
  <section aria-labelledby="home-carousel-title" data-testid="home-carousel">
    <h2 id="home-carousel-title" class="section-title">
      À la une
    </h2>
    {carousel.status === 'error' ? (
      <Alert variant="error" data-testid="home-carousel-error">
        {carousel.message}
      </Alert>
    ) : (
      <ImageCarousel client:visible slides={carousel.slides} label="À la une" />
    )}
  </section>
)}
