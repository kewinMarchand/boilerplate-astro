---
import { CATALOG_NAVIGATION, navigationLabel } from '@/shared/config'
import { format } from '@/shared/i18n'
import { resolveHref } from '@/shared/routing'
import { localizedUrl } from '@/shared/seo'
import { Alert, Badge, Button, ImagePreload, largestWebp, ResponsiveImage } from '@/shared/ui/kit'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { inquiryHref, productHref } from '../domain/catalog'
import { CATALOG_ROOT_PATH } from '../domain/categoryPath'
import { formatPrice } from '../domain/price'
import ProductGallery from './ProductGallery.svelte'
import SimilarProducts from './SimilarProducts.astro'

import type { Catalog } from '../domain/catalog'
import type { Seo } from '@/shared/seo'

interface Props {
  product: Catalog.ProductPage
  /** Faux : ni prix ni panier, une demande de renseignement à la place (section 27). */
  salesEnabled: boolean
}

const { product, salesEnabled } = Astro.props
const { dictionary: t, locale } = Astro.locals
const IMAGE_SIZES = '(min-width: 1440px) 680px, (min-width: 768px) 50vw, calc(100vw - 32px)'
const CATALOG: Seo.BreadcrumbItem = {
  label: navigationLabel(CATALOG_NAVIGATION, t),
  path: CATALOG_ROOT_PATH,
}
const detail = product.status === 'success' ? product.product : null
const image = detail?.image ?? null
const galleryImages = detail?.gallery.length ? [...(image ? [image] : []), ...detail.gallery] : []
const category = detail?.categoryPath.at(-1)
const parents: Seo.BreadcrumbItem[] = [
  CATALOG,
  ...(detail?.categoryPath ?? []).map((link) => ({ label: link.name, path: link.path })),
]
const description = detail
  ? format(t.product.description, {
      name: detail.name,
      exposure: t.catalog.exposures[detail.exposure].toLowerCase(),
      size: detail.size,
      price: salesEnabled
        ? format(t.product.descriptionPrice, { price: formatPrice(detail.price, t.language.tag) })
        : '',
      stock: detail.inStock ? t.product.descriptionInStock : t.product.descriptionOutOfStock,
      category: category?.name ?? t.product.noCategory,
    })
  : t.product.fallbackDescription
const seo = detail
  ? {
      metaTitle: detail.metaTitle,
      metaDescription: detail.metaDescription,
      image: image
        ? {
            path: largestWebp(image),
            width: image.width,
            height: image.height,
            alt: image.alt || detail.name,
          }
        : undefined,
      jsonLd: [
        {
          '@context': 'https://schema.org',
          '@type': 'Product',
          name: detail.name,
          ...(detail.description.length > 0 && { description: detail.description.join(' ') }),
          sku: detail.slug,
          url: localizedUrl(productHref(detail.slug), locale),
          ...(category && { category: category.name }),
          ...(image && { image: largestWebp(image) }),
          ...(salesEnabled && {
            offers: {
              '@type': 'Offer',
              url: localizedUrl(productHref(detail.slug), locale),
              priceCurrency: 'EUR',
              price: (detail.price / 100).toFixed(2),
              availability: `https://schema.org/${detail.inStock ? 'InStock' : 'OutOfStock'}`,
            },
          }),
        },
      ],
    }
  : { noindex: true }
---

<PageLayout
  title={detail?.name ?? t.product.fallbackTitle}
  {description}
  parents={detail ? parents : [CATALOG]}
  {seo}
  headingTestId="product-title"
  alternates={detail?.alternates}
>
  {image && <ImagePreload slot="head" {image} sizes={IMAGE_SIZES} />}
  {product.status === 'error' ? (
    <Alert variant="error" data-testid="product-error">
      {t.product.loadError}
    </Alert>
  ) : (
    detail && (
      <article class="product-page" data-testid="product-page">
        {galleryImages.length > 0 ? (
          <ProductGallery
            client:idle
            images={galleryImages}
            sizes={IMAGE_SIZES}
            imageLabel={t.product.galleryImage}
          />
        ) : (
          image && (
            <ResponsiveImage
              {image}
              sizes={IMAGE_SIZES}
              priority
              pictureClass="rounded-md"
              class="aspect-square h-auto w-full rounded-md object-cover"
            />
          )
        )}
        <div>
          {salesEnabled && (
            <p class="text-lead font-semibold" data-testid="product-price">
              {formatPrice(detail.price, t.language.tag)}
            </p>
          )}
          {detail.description.length > 0 && (
            <div data-testid="product-description">
              {detail.description.map((paragraph) => (
                <p class="product-paragraph">{paragraph}</p>
              ))}
            </div>
          )}
          <dl class="product-features">
            <dt>{t.product.exposure}</dt>
            <dd>{t.catalog.exposures[detail.exposure]}</dd>
            <dt>{t.product.size}</dt>
            <dd>{detail.size}</dd>
            <dt>{t.product.availability}</dt>
            <dd>
              {detail.inStock ? (
                t.product.inStock
              ) : (
                <Badge variant="error">{t.product.outOfStock}</Badge>
              )}
            </dd>
          </dl>
          {detail.attributes.length > 0 && (
            <dl class="product-features" data-testid="product-attributes">
              {detail.attributes.map((attribute) => (
                <Fragment>
                  <dt>{attribute.label}</dt>
                  <dd>
                    {attribute.unit ? `${attribute.value}\u00a0${attribute.unit}` : attribute.value}
                  </dd>
                </Fragment>
              ))}
            </dl>
          )}
          {salesEnabled ? (
            <slot name="purchase" />
          ) : (
            <div class="mb-6">
              <Button
                href={resolveHref(inquiryHref(detail.slug))}
                aria-label={format(t.product.inquiryAbout, { name: detail.name })}
                data-testid="product-inquiry"
              >
                {t.product.inquiry}
              </Button>
            </div>
          )}
          {category && (
            <p>
              <a href={resolveHref(category.path)} class="bui-link">
                {format(t.product.otherProducts, { category: category.name })}
              </a>
            </p>
          )}
        </div>
      </article>
    )
  )}
  {detail && (
    <SimilarProducts categorySlug={detail.categorySlug} productSlug={detail.slug} {salesEnabled} />
  )}
</PageLayout>

<style>
  .product-page {
    display: grid;
    gap: var(--bui-space-8);
    align-items: start;
  }

  @media (min-width: 768px) {
    .product-page {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .product-features {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--bui-space-2) var(--bui-space-6);
    margin-block: var(--bui-space-6);
  }

  .product-features dt {
    font-weight: 600;
  }

  .product-paragraph {
    margin-block: 0 var(--bui-space-4);
  }
</style>
