---
import { ClientRouter } from 'astro:transitions'

import { ImagePreload } from '@/shared/ui/kit'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { describeCatalogPage } from './catalogPage'
import CatalogView from './CatalogView.svelte'
import { catalogIslandResult, catalogLabels } from './labels'
import { PRODUCT_IMAGE_SIZES } from './productImage'

import type { Catalog } from '../domain/catalog'

interface Props {
  query: Catalog.Query
  result: Catalog.Result
  salesEnabled: boolean
  /** La page dans chaque langue ; inconnue si l'API est en erreur (même chemin partout). */
  alternates: Catalog.Alternate[] | undefined
}

const { query, result, salesEnabled, alternates } = Astro.props
const { dictionary, locale } = Astro.locals
const { title, description, page, parents, seo } = describeCatalogPage(
  query,
  result,
  dictionary,
  locale,
)
const t = catalogLabels(dictionary)
const firstImage = result.status === 'success' ? result.listing.products[0]?.image : undefined
---

<PageLayout {title} {description} {page} {parents} {seo} {alternates}>
  <ClientRouter slot="head" />
  {firstImage && <ImagePreload slot="head" image={firstImage} sizes={PRODUCT_IMAGE_SIZES} />}
  <CatalogView
    client:load
    transition:persist="catalogue"
    {query}
    result={catalogIslandResult(result)}
    {salesEnabled}
    {t}
  />
</PageLayout>
