---
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { tasksApiScenario, tasksApiUrl } from '../infrastructure/taskRepository'
import TasksPanel from './TasksPanel.svelte'

const { dictionary: t, locale } = Astro.locals
const { title, description, intro, ...labels } = t.tasks
const scenario = tasksApiScenario()
---

<PageLayout {title} {description}>
  <p class="lead">{intro}</p>
  <TasksPanel
    client:load
    apiUrl={tasksApiUrl()}
    labels={{ ...labels, alert: { info: t.ui.alert.info, error: t.ui.alert.error } }}
    {...(locale.locales.length > 1 && { locale: locale.locale })}
    {...(scenario && { scenario })}
  />
</PageLayout>
