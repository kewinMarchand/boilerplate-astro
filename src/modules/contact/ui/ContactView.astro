---
import { actions } from 'astro:actions'

import { resolveHref } from '@/shared/routing'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import ContactForm from './ContactForm.svelte'

import type { Contact } from '../domain/contactSchema'

interface Props {
  /** Demande de renseignement : le produit, trouvé dans l'API, dont le slug part avec le message. */
  product: Contact.Product | null
}

const { product } = Astro.props
const { dictionary: t, locale } = Astro.locals
const { title, description, intro, product: productLabel, ...labels } = t.contact
// L'envoi sans JavaScript revient sur la même page : le produit reste dans l'adresse.
const formParams = new URLSearchParams(String(actions.contact))
if (product) formParams.set('produit', product.slug)

// Envoi sans JavaScript : l'action a traité le POST, la page affiche son résultat.
const result = Astro.getActionResult(actions.contact)
const outcome = result?.data
const sent = outcome?.status === 'sent'
const submitted = outcome && outcome.status !== 'sent' ? outcome.values : undefined
const values: Contact.FormValues = {
  name: submitted?.name ?? '',
  email: submitted?.email ?? '',
  message: submitted?.message ?? '',
}
const errors: Contact.FieldErrors = outcome?.status === 'invalid' ? outcome.fieldErrors : {}
const status = sent ? 'sent' : outcome?.status === 'error' || result?.error ? 'error' : undefined
---

<PageLayout page="contact" {title} {description}>
  <p class="lead">{intro}</p>
  {product && (
    <p data-testid="contact-product">
      {productLabel}{' '}
      <a href={resolveHref(product.path)} class="bui-link">
        {product.name}
      </a>
    </p>
  )}
  <ContactForm
    client:load
    formAction={`?${formParams}`}
    product={product?.slug}
    {values}
    {errors}
    {status}
    {labels}
    locale={locale.locales.length > 1 ? locale.locale : undefined}
  />
</PageLayout>
