---
import { actions, isInputError } from 'astro:actions'

import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import ContactForm from './ContactForm.svelte'

import type { Contact } from '../domain/contactSchema'

interface Props {
  /** Demande de renseignement : le produit, trouvé dans l'API, dont le slug part avec le message. */
  product: Contact.Product | null
}

const { product } = Astro.props
// L'envoi sans JavaScript revient sur la même page : le produit reste dans l'adresse.
const formParams = new URLSearchParams(String(actions.contact))
if (product) formParams.set('produit', product.slug)

// Envoi sans JavaScript : l'action a traité le POST, la page affiche son résultat.
const result = Astro.getActionResult(actions.contact)
const submitted = Astro.request.method === 'POST' ? await Astro.request.formData() : undefined
const valueOf = (field: Contact.Field) => {
  const value = submitted?.get(field)
  return typeof value === 'string' ? value : ''
}

const outcome = result?.data
const sent = outcome?.status === 'sent'
const values: Contact.FormValues = sent
  ? { name: '', email: '', message: '' }
  : { name: valueOf('name'), email: valueOf('email'), message: valueOf('message') }
const errors: Contact.FieldErrors =
  result?.error && isInputError(result.error)
    ? result.error.fields
    : outcome?.status === 'invalid'
      ? outcome.fieldErrors
      : {}
const status = sent
  ? 'sent'
  : outcome?.status === 'error' || (result?.error && !isInputError(result.error))
    ? 'error'
    : undefined
---

<PageLayout
  page="contact"
  title="Contact"
  description="Démo de formulaire : validation par schéma zod, erreurs liées aux champs, envoi par une action serveur Astro, avec ou sans JavaScript."
>
  <p class="lead">
    Formulaire validé par un schéma zod, envoyé par une action serveur Astro. Il fonctionne aussi
    sans JavaScript.
  </p>
  {product && (
    <p data-testid="contact-product">
      Votre demande concerne :{' '}
      <a href={product.path} class="bui-link">
        {product.name}
      </a>
    </p>
  )}
  <ContactForm
    client:load
    formAction={`?${formParams}`}
    product={product?.slug}
    {values}
    {errors}
    {status}
  />
</PageLayout>
