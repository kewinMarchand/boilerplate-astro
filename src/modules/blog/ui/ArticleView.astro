---
import { BLOG_NAVIGATION, navigationLabel } from '@/shared/config'
import { resolveHref } from '@/shared/routing'
import { localizedUrl } from '@/shared/seo'
import { Alert, ImagePreload, largestWebp, ResponsiveImage } from '@/shared/ui/kit'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { articleHref, sectionHref } from '../domain/article'
import { formatDuration, isoDuration } from '../domain/formatDuration'
import { formatPublishedAt } from '../domain/formatPublishedAt'

import type { Article } from '../domain/article'

interface Props {
  article: Article.Page
}

// HTML venu de l'API, qui échappe le HTML saisi dans l'admin et retire les liens dangereux : injecté tel quel.
const { article } = Astro.props
const { dictionary: t, locale } = Astro.locals
const IMAGE_SIZES = '(min-width: 800px) 760px, calc(100vw - 32px)'
const detail = article.status === 'success' ? article.article : null
const image = detail?.image ?? null
const seo = detail
  ? {
      metaTitle: detail.metaTitle,
      metaDescription: detail.metaDescription,
      publishedTime: detail.publishedAt,
      image: image
        ? {
            path: largestWebp(image),
            width: image.width,
            height: image.height,
            alt: image.alt || detail.title,
          }
        : undefined,
      jsonLd: [
        {
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: detail.title,
          description: detail.excerpt,
          datePublished: detail.publishedAt,
          url: localizedUrl(articleHref(detail.slug), locale),
          ...(image && { image: largestWebp(image) }),
          inLanguage: t.language.tag,
        },
      ],
    }
  : { noindex: true }
---

<PageLayout
  title={detail?.title ?? t.blog.articleFallbackTitle}
  description={detail ? detail.excerpt || detail.title : t.blog.articleFallbackDescription}
  parents={[{ label: navigationLabel(BLOG_NAVIGATION, t), path: BLOG_NAVIGATION.href }]}
  {seo}
  headingTestId="article-title"
  alternates={detail?.alternates}
>
  {image && <ImagePreload slot="head" {image} sizes={IMAGE_SIZES} />}
  {article.status === 'error' ? (
    <Alert variant="error" data-testid="article-error">
      {t.blog.articleError}
    </Alert>
  ) : (
    <article class="max-w-prose" data-testid="article-page">
      {(article.article.section || article.article.format) && (
        <p class="mb-2 flex flex-wrap gap-x-3 text-body-sm font-semibold">
          {article.article.section && (
            <a
              href={resolveHref(sectionHref(article.article.section.slug))}
              class="bui-link"
              data-testid="article-section"
            >
              {article.article.section.name}
            </a>
          )}
          {article.article.format && (
            <span data-testid="article-format">{article.article.format.name}</span>
          )}
        </p>
      )}
      <p class="mb-6 text-body-sm text-text-muted">
        {t.blog.publishedOn}{' '}
        <time datetime={article.article.publishedAt}>
          {formatPublishedAt(article.article.publishedAt, t.language.tag)}
        </time>
      </p>
      {article.article.audio && (
        <figure class="mb-6 flex flex-col gap-2">
          <figcaption class="flex flex-wrap gap-x-3 text-body-sm text-text-muted">
            <span>
              {t.blog.audio}{' '}
              <time datetime={isoDuration(article.article.audio.durationSeconds)}>
                {formatDuration(article.article.audio.durationSeconds)}
              </time>
            </span>
            {article.article.speaker && (
              <span data-testid="article-speaker">{article.article.speaker}</span>
            )}
          </figcaption>
          <audio
            controls
            preload="none"
            class="w-full"
            aria-label={t.blog.audioLabel}
            data-testid="article-audio"
          >
            <source src={article.article.audio.src} type={article.article.audio.type} />
            <a href={article.article.audio.src} class="bui-link">
              {t.blog.audioDownload}
            </a>
          </audio>
        </figure>
      )}
      {image && (
        <ResponsiveImage
          {image}
          sizes={IMAGE_SIZES}
          priority
          pictureClass="rounded-md"
          class="aspect-video h-auto w-full rounded-md object-cover"
        />
      )}
      {article.article.excerpt && <p class="my-6 text-lead">{article.article.excerpt}</p>}
      <div class="prose-legal" data-testid="article-body">
        <Fragment set:html={article.article.html} />
      </div>
      <p class="mt-12">
        <a href={resolveHref(BLOG_NAVIGATION.href)} class="bui-link">
          {t.blog.all}
        </a>
      </p>
    </article>
  )}
</PageLayout>
