---
import { BLOG_NAVIGATION, navigationLabel } from '@/shared/config'
import { resolveHref } from '@/shared/routing'
import { localizedUrl } from '@/shared/seo'
import { Alert, Button, Icon } from '@/shared/ui/kit'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { articleHref, sectionHref } from '../domain/article'
import BlogCard from './BlogCard.svelte'

import type { Article } from '../domain/article'

interface Props {
  blog: Article.Blog
  sections: Article.Term[]
  /** Slug du paramètre `rubrique`, absent pour toutes les rubriques. */
  activeSection?: string | undefined
}

const { blog, sections, activeSection } = Astro.props
const { dictionary: t, locale } = Astro.locals
const blogLabel = navigationLabel(BLOG_NAVIGATION, t)
const filters = [
  { label: t.blog.allSections, href: BLOG_NAVIGATION.href, active: !activeSection },
  ...sections.map((section) => ({
    label: section.name,
    href: sectionHref(section.slug),
    active: section.slug === activeSection,
  })),
]
const articles = blog.status === 'success' ? blog.articles : []
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: blogLabel,
    url: localizedUrl(BLOG_NAVIGATION.href, locale),
    inLanguage: t.language.tag,
    blogPost: articles.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.title,
      datePublished: article.publishedAt,
      url: localizedUrl(articleHref(article.slug), locale),
    })),
  },
]
---

<PageLayout page="blog" title={blogLabel} description={t.blog.description} seo={{ jsonLd }}>
  {sections.length > 0 && (
    <nav aria-label={t.blog.sections} class="mb-6" data-testid="blog-sections">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {filters.map((filter) => (
          <li>
            <a
              href={resolveHref(filter.href)}
              class="bui-link aria-[current=page]:font-semibold aria-[current=page]:no-underline"
              aria-current={filter.active ? 'page' : undefined}
              data-testid="blog-section-link"
            >
              {filter.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <div aria-live="polite">
    {blog.status === 'error' ? (
      <div class="flex flex-col items-start gap-3">
        <Alert variant="error" prefix={t.ui.alert.error} data-testid="blog-error">
          {t.blog.loadError}
        </Alert>
        <Button
          variant="outline"
          href={resolveHref(activeSection ? sectionHref(activeSection) : BLOG_NAVIGATION.href)}
          data-testid="blog-retry"
        >
          <Icon name="rotate-cw" />
          {t.blog.retry}
        </Button>
      </div>
    ) : articles.length === 0 ? (
      <Alert variant="info" prefix={t.ui.alert.info} data-testid="blog-empty">
        {activeSection ? t.blog.emptySection : t.blog.empty}
      </Alert>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-testid="blog-list">
        {articles.map((article) => (
          <BlogCard {article} testId="blog-card" headingLevel={2} tag={t.language.tag} />
        ))}
      </div>
    )}
  </div>
</PageLayout>
