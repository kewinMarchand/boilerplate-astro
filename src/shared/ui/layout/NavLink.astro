---
import { isActivePath } from '@/shared/config'
import { resolveHref } from '@/shared/routing'
import { Button } from '@/shared/ui/kit'

import type { NavigationItem } from '@/shared/config'

type Props = NavigationItem

const { href, label } = Astro.props
const isActive = isActivePath(Astro.url.pathname, href)
---

<Button href={resolveHref(href)} variant="nav" aria-current={isActive ? 'page' : undefined}>
  {label}
</Button>
