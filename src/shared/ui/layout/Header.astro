---
import { CATALOG_NAVIGATION, MAIN_NAVIGATION } from '@/shared/config'
import { A11yModeToggle } from '@/shared/ui/a11y-mode'
import { ColorSchemeToggle } from '@/shared/ui/color-scheme'
import { ResponsiveImage } from '@/shared/ui/kit'

import CategoryMenu from './CategoryMenu.svelte'
import MobileMenu from './MobileMenu.svelte'
import NavLink from './NavLink.astro'

import type { NavigationNode } from '@/shared/config'

interface Props {
  categoryMenu: NavigationNode[]
}

const { categoryMenu } = Astro.props
const { cartLink: CartLink, siteIdentity } = Astro.locals
const { name, logo } = siteIdentity
const LOGO_HEIGHT = 40
const { pathname } = Astro.url
const [home, ...otherLinks] = MAIN_NAVIGATION
---

<header class="bg-primary text-on-primary">
  <div class="container-page header-bar">
    <a
      href="/"
      class="logo-link min-w-0 grow"
      aria-current={pathname === '/' ? 'page' : undefined}
      data-testid="layout-logo"
    >
      {logo ? (
        <ResponsiveImage
          image={{ ...logo, alt: name }}
          sizes={`${Math.round((LOGO_HEIGHT * logo.width) / logo.height)}px`}
          priority
          class="h-[40px] w-auto"
        />
      ) : (
        <>
          <img src="/logo-mark.svg" alt="" width="40" height="40" />
          {name}
        </>
      )}
    </a>
    <nav aria-label="Navigation principale" class="js:max-lg:hidden">
      <ul class="flex flex-wrap gap-1">
        {home && (
          <li>
            <NavLink {...home} />
          </li>
        )}
        <li class="js:hidden">
          <NavLink {...CATALOG_NAVIGATION} />
        </li>
        <li class="hidden js:block">
          <CategoryMenu client:media="(min-width: 1024px)" nodes={categoryMenu} />
        </li>
        {otherLinks.map((item) => (
          <li>
            <NavLink {...item} />
          </li>
        ))}
      </ul>
    </nav>
    <div class="hidden js:max-lg:block">
      <MobileMenu client:media="(max-width: 1023.98px)" nodes={categoryMenu} {pathname} />
    </div>
    <CartLink />
    <ColorSchemeToggle client:load />
    <A11yModeToggle client:load />
  </div>
</header>
