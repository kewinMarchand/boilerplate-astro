---
import { OBSERVABILITY_CONFIG_ID } from '@/shared/observability'
import { observabilityConfig } from '@/shared/observability/index.server'
import { SeoHead } from '@/shared/seo'
import { A11Y_MODE_SCRIPT } from '@/shared/ui/a11y-mode'
import { COLOR_SCHEME_SCRIPT } from '@/shared/ui/color-scheme'

import Footer from './Footer.astro'
import Header from './Header.astro'

import type { NavigationNode } from '@/shared/config'
import type { Seo } from '@/shared/seo'

import '@/shared/theme/theme.css'

interface Props {
  meta: Seo.Meta
  categoryMenu?: NavigationNode[] | undefined
}

const { meta, categoryMenu = Astro.locals.categoryMenu } = Astro.props

// Amorçage avant le premier rendu : classe js (amélioration progressive), mode renforcé, thème mémorisé.
// Rejoué après chaque navigation du routeur client (catalogue), qui remplace les attributs de <html>.
const BOOT = `document.documentElement.classList.add('js');${A11Y_MODE_SCRIPT}${COLOR_SCHEME_SCRIPT}`
const BOOT_SCRIPT = `(()=>{const boot=()=>{${BOOT}};boot();if(!window.__boot){window.__boot=true;document.addEventListener('astro:after-swap',boot)}})()`
---

<!doctype html>
<html lang="fr" data-color-scheme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline set:html={BOOT_SCRIPT} />
    <SeoHead {meta} />
    <slot name="head" />
    <script
      type="application/json"
      id={OBSERVABILITY_CONFIG_ID}
      set:html={JSON.stringify(observabilityConfig()).replace(/</g, '\\u003c')}
    />
    <script>
      import { startObservability } from '@/shared/observability/client'

      startObservability()
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <a href="#main" class="skip-link">
        Aller au contenu principal
      </a>
      <Header {categoryMenu} />
      <main id="main" tabindex="-1" class="page-grid grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
