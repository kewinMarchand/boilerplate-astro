---
import { toAppPath } from '@/shared/routing'
import { buildBreadcrumb, buildPageMeta } from '@/shared/seo'

import BaseLayout from './BaseLayout.astro'
import Breadcrumb from './Breadcrumb.astro'

import type { NavigationNode } from '@/shared/config'
import type { Seo } from '@/shared/seo'

// Page interne : fil d'Ariane et métadonnées calculés d'une seule source, puis le <h1>.
interface Props {
  title: string
  /** Texte du <h1> s'il diffère du titre (contenu administré dans l'API). */
  heading?: string | undefined
  description: string
  /** Page fixe : titre et description saisis dans l'admin, s'il y en a, remplacent les valeurs calculées. */
  page?: Seo.PageKey | undefined
  parents?: Seo.BreadcrumbItem[]
  seo?: Omit<Seo.Input, 'title' | 'description' | 'path' | 'breadcrumb'>
  categoryMenu?: NavigationNode[] | undefined
  headingTestId?: string | undefined
}

const {
  title,
  heading = title,
  description,
  page,
  parents = [],
  seo = {},
  categoryMenu,
  headingTestId,
} = Astro.props
const path = toAppPath(Astro.url.pathname)
const breadcrumb = buildBreadcrumb({ label: title, path }, parents)
const pageMeta = page && Astro.locals.pageMetas[page]
const meta = buildPageMeta(
  {
    ...seo,
    ...(pageMeta && { metaTitle: pageMeta.title, metaDescription: pageMeta.description }),
    title,
    description,
    path,
    breadcrumb,
  },
  Astro.locals.siteIdentity,
)
---

<BaseLayout {meta} {categoryMenu}>
  <slot name="head" slot="head" />
  <Breadcrumb items={breadcrumb} />
  <h1 id="page-title" tabindex="-1" class="heading-1" data-testid={headingTestId}>
    {heading}
  </h1>
  <slot />
</BaseLayout>
