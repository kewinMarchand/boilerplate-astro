---
import { languageName } from '@/shared/i18n'
import { resolveHref } from '@/shared/routing'

import type { LanguageAlternate } from '@/shared/i18n'

interface Props {
  /** La page dans chaque langue où elle existe ; sans équivalent, l'accueil de cette langue. */
  alternates: LanguageAlternate[]
}

const { alternates } = Astro.props
const { locale, dictionary: t } = Astro.locals
const links = locale.locales.map((code) => ({
  code,
  href: resolveHref(alternates.find((alternate) => alternate.locale === code)?.path ?? '/', code),
}))
---

{/*
  Absent sur un site monolingue. Liens simples, sans JavaScript ; changer de langue recharge la page
  (`data-astro-reload`, le routeur client du catalogue garderait sinon l'îlot et ses libellés).
*/}
{locale.locales.length > 1 && (
  <nav
    aria-label={t.layout.languages}
    class="container-page flex justify-end"
    data-ui-chrome
    data-testid="layout-languages"
  >
    <ul class="flex gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            lang={link.code}
            hreflang={link.code}
            aria-current={link.code === locale.locale ? 'true' : undefined}
            class="inline-flex min-h-touch items-center rounded-md px-2 text-body-sm text-inherit no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current aria-[current=true]:font-bold aria-[current=true]:underline"
            data-astro-reload
            data-testid={`layout-language-${link.code}`}
          >
            {languageName(link.code)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
