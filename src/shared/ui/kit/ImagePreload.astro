---
import type { ImageView } from './image'

// Préchargement de l'image LCP, posé dans le <head> par la vue (slot « head » du layout) : sa première source (AVIF).
interface Props {
  image: ImageView
  sizes: string
}

const { image, sizes } = Astro.props
const [first] = image.sources
---

{first && (
  <link
    rel="preload"
    as="image"
    type={first.type}
    imagesrcset={first.srcset}
    imagesizes={sizes}
    fetchpriority="high"
  />
)}
