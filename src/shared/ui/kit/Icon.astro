---
import type { IconName } from './iconNames'

interface Props {
  name: IconName
  class?: string
  /** Icône porteuse de sens : nom accessible. Sans lui, l'icône est décorative. */
  label?: string
}

const { name, class: className, label } = Astro.props
---

{label ? (
  <svg class:list={['bui-icon', className]} role="img" aria-label={label}>
    <use href={`/icons.svg#${name}`} />
  </svg>
) : (
  <svg class:list={['bui-icon', className]} aria-hidden="true">
    <use href={`/icons.svg#${name}`} />
  </svg>
)}
