---
import { SITE } from '@/shared/config'
import { buildHomeJsonLd, buildPageMeta } from '@/shared/seo'
import { ImageCarousel } from '@/shared/ui/carousel'
import { ImagePreload } from '@/shared/ui/kit'
import BaseLayout from '@/shared/ui/layout/BaseLayout.astro'

import { BlogSection } from '@/modules/blog'

import { HOME_SLIDES } from './featuredSlides'
import Hero from './Hero.astro'
import { HERO_IMAGE } from './heroImage'

import type { Article } from '@/modules/blog'

interface Props {
  blog: Article.Blog
}

const { blog } = Astro.props

const meta = buildPageMeta({ description: SITE.description, path: '/', jsonLd: buildHomeJsonLd() })
---

<BaseLayout {meta}>
  <ImagePreload
    slot="head"
    basePath={HERO_IMAGE.basePath}
    widths={HERO_IMAGE.widths}
    sizes={HERO_IMAGE.sizes}
  />
  <Hero />

  <section aria-labelledby="home-carousel-title" data-testid="home-carousel">
    <h2 id="home-carousel-title" class="section-title">
      À la une
    </h2>
    <ImageCarousel client:visible slides={HOME_SLIDES} label="À la une" />
  </section>

  <BlogSection {blog} />
</BaseLayout>
