---
import { SITE } from '@/shared/config'
import { buildHomeJsonLd, buildPageMeta } from '@/shared/seo'
import { ImagePreload } from '@/shared/ui/kit'
import BaseLayout from '@/shared/ui/layout/BaseLayout.astro'

import { BlogSection } from '@/modules/blog'
import { FeaturedProducts } from '@/modules/catalog'

import Hero from './Hero.astro'
import { HERO_IMAGE } from './heroImage'

import type { Article } from '@/modules/blog'
import type { Catalog } from '@/modules/catalog'

interface Props {
  featured: Catalog.Featured
  blog: Article.Blog
}

const { featured, blog } = Astro.props

const meta = buildPageMeta({ description: SITE.description, path: '/', jsonLd: buildHomeJsonLd() })
---

<BaseLayout {meta}>
  <ImagePreload slot="head" image={HERO_IMAGE.image} sizes={HERO_IMAGE.sizes} />
  <Hero />

  <FeaturedProducts {featured} />

  <BlogSection {blog} />
</BaseLayout>
