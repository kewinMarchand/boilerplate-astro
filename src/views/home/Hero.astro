---
import { Button, ResponsiveImage } from '@/shared/ui/kit'

import { HERO_IMAGE } from './heroImage'

interface Props {
  name: string
  tagline: string
}

const { name, tagline } = Astro.props
---

<div class="hero full-bleed" data-testid="home-hero">
  <ResponsiveImage image={HERO_IMAGE.image} sizes={HERO_IMAGE.sizes} priority class="hero-media" />
  <div class="hero-overlay"></div>
  <div class="container-page py-12">
    <div class="max-w-prose">
      <p class="hero-overline">Boilerplate Astro</p>
      <h1 class="heading-1">{name}</h1>
      <p class="mb-8 text-title">{tagline}</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href="/taches" variant="light" data-testid="home-tasks-link">
          Voir la démo des tâches
        </Button>
        <Button href="/contact" variant="outline-light" data-testid="home-contact-link">
          Voir le formulaire
        </Button>
      </div>
    </div>
  </div>
</div>
