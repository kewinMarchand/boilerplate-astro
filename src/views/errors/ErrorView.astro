---
import { resolveHref, toAppPath } from '@/shared/routing'
import { Button } from '@/shared/ui/kit'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

interface Props {
  status: number
}

const { status } = Astro.props
const t = Astro.locals.dictionary
const isNotFound = status === 404
const title = isNotFound ? t.errors.notFoundTitle : t.errors.serverTitle
const description = isNotFound ? t.errors.notFoundDescription : t.errors.serverDescription
// Sans équivalent connu : le sélecteur de langue mène à l'accueil de chaque langue.
---

<PageLayout {title} {description} seo={{ noindex: true }} alternates={[]}>
  <p class="lead">{description}</p>
  <div class="flex flex-wrap gap-4">
    {!isNotFound && (
      <Button href={resolveHref(toAppPath(Astro.url.pathname))} data-testid="error-retry">
        {t.errors.retry}
      </Button>
    )}
    <Button
      href={resolveHref('/')}
      variant={isNotFound ? 'primary' : 'outline'}
      data-testid="error-home-link"
    >
      {t.errors.home}
    </Button>
    {isNotFound && (
      <Button
        href={resolveHref('/plan-du-site')}
        variant="outline"
        data-testid="error-sitemap-link"
      >
        {t.errors.sitemap}
      </Button>
    )}
    {isNotFound && (
      <Button href={resolveHref('/catalogue')} variant="outline" data-testid="error-catalog-link">
        {t.errors.catalog}
      </Button>
    )}
  </div>
</PageLayout>
