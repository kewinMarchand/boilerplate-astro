---
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import { LegalPageContent } from '@/modules/content'

import type { LegalPage } from '@/modules/content'

interface Props {
  legalPage: LegalPage.Content
}

const { legalPage } = Astro.props
const title = 'Mentions légales'
---

<PageLayout
  {title}
  heading={legalPage.status === 'success' ? legalPage.page.title : title}
  description="Mentions légales du site : éditeur, directeur de la publication, hébergeur et propriété intellectuelle."
>
  <div class="prose-legal">
    <LegalPageContent page={legalPage} />
  </div>
</PageLayout>
