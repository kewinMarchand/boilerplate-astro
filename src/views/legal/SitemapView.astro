---
import { ALL_NAVIGATION, CATALOG_NAVIGATION, navigationLabel } from '@/shared/config'
import { resolveHref } from '@/shared/routing'
import PageLayout from '@/shared/ui/layout/PageLayout.astro'

import SitemapTree from './SitemapTree.astro'

import type { NavigationNode } from '@/shared/config'

interface Props {
  categories: NavigationNode[]
}

const { categories } = Astro.props
const t = Astro.locals.dictionary
---

<PageLayout page="sitemap" title={t.legal.sitemapTitle} description={t.legal.sitemapDescription}>
  <div class="prose-legal">
    <ul data-testid="legal-sitemap">
      {ALL_NAVIGATION.map((item) => (
        <li>
          <a href={resolveHref(item.href)}>{navigationLabel(item, t)}</a>
          {item.href === CATALOG_NAVIGATION.href && <SitemapTree nodes={categories} />}
        </li>
      ))}
    </ul>
  </div>
</PageLayout>
