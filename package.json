{
  "name": "boilerplate-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Boilerplate Astro, boilerplates-ui (Svelte rendu serveur, îlots), TypeScript et zod, avec lint, tests unitaires, e2e, accessibilité et Lighthouse",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321 --host 0.0.0.0",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check --minimumSeverity warning",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "lhci": "lhci autorun",
    "lhci:sombre": "lhci autorun --collect.settings.chromeFlags=\"--headless=new --no-sandbox --blink-settings=preferredColorScheme=0\" --upload.outputDir=.lighthouseci/reports-sombre",
    "api:types": "openapi-typescript $API_SCHEMA_URL --output src/shared/api/schema.d.ts"
  },
  "lint-staged": {
    "*.{ts,astro,svelte,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@boundaries/eslint-plugin": "^7.2.0",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.143",
    "@kewinmarchand/boilerplates-ui": "github:kewinMarchand/boilerplates-ui#v0.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svgstore": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}
