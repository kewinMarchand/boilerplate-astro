{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4119 HOST=127.0.0.1 yarn start",
      "startServerReadyPattern": "listening",
      "url": [
        "http://localhost:4119/",
        "http://localhost:4119/taches",
        "http://localhost:4119/contact",
        "http://localhost:4119/catalogue",
        "http://localhost:4119/catalogue/plantes-interieur",
        "http://localhost:4119/catalogue/plantes-interieur/feuillages",
        "http://localhost:4119/mentions-legales",
        "http://localhost:4119/donnees-personnelles",
        "http://localhost:4119/accessibilite",
        "http://localhost:4119/plan-du-site",
        "http://localhost:4119/blog",
        "http://localhost:4119/blog/le-mode-accessibilite-renforcee",
        "http://localhost:4119/produit/monstera-deliciosa"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
